# Credenciais da API do Telegram (obtenha em https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Diretório onde todos os itens (chats.md, pastas de chats e .tghoard/) são salvos
# Valor padrão: ./data (dentro do repositório)
TGHOARD_DATA_DIR=./data

# Tamanho máximo alvo (em KB) para cada arquivo chats/YYYY-MM-DD-ptNNN.json
TGHOARD_MAX_JSON_KB=1024

# Tamanho máximo (em MB) por anexo individual (0 = ilimitado)
TGHOARD_MAX_MEDIA_MB=50

# Concorrência máxima para downloads de mídia e chamadas paginadas
TGHOARD_CONCURRENCY=3

# Modo de sincronização: auto | takeout | standard
TGHOARD_SYNC_MODE=auto

# Quantidade de mensagens recentes para reconciliação caso o PTS expire (DifferenceTooLong)
TGHOARD_AUDIT_WINDOW=200
