# Telegram API credentials (get them at https://my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=

# Directory where everything (chats.md, the archive folders and .tghoard/) is saved
# Default: ./data (inside the repository)
TGHOARD_DATA_DIR=./data

# Target maximum size (KB) of each messages/<folder>/YYYY-MM-ptNNN.json part
TGHOARD_MAX_JSON_KB=1024

# Maximum size (MB) of a single attachment (0 = unlimited); larger ones stay queued
TGHOARD_MAX_MEDIA_MB=50

# Download pool workers per account (simultaneous media downloads, max 32)
TGHOARD_CONCURRENCY=5

# Download pool queue: how many downloads may wait before message reading is held back
TGHOARD_DOWNLOAD_QUEUE=1024

# Minimum pause (s) between 100-message history pages (0 = no pause)
TGHOARD_HISTORY_WAIT=0

# Auto-throttle: FloodWaits raise the pause / cut parallelism; quiet periods restore them
TGHOARD_AUTO_THROTTLE=true

# Auto-throttle of simultaneous downloads:
#  - geometric cut on each download FloodWait: value x ratio (0.5 = 32 -> 16 -> 8 -> 4 -> 2 -> 1)
#  - linear recovery (+1) every N seconds without a FloodWait
TGHOARD_THROTTLE_CUT_RATIO=0.5
TGHOARD_THROTTLE_RECOVER_SECS=20

# How many chats to sync at the same time per account (accounts also run in parallel)
TGHOARD_PARALLEL_CHATS=4

# Sync mode: auto | takeout | standard
TGHOARD_SYNC_MODE=auto

# Number of recent messages reconciled when the PTS expires (DifferenceTooLong)
TGHOARD_AUDIT_WINDOW=200

# Port of the local web UI opened with `tghoard sync` (or `tghoard web`)
TGHOARD_WEB_PORT=8765

# Chat metadata (info, members, stories, admin log, profile photos): at most every N hours (0 = every sync)
TGHOARD_METADATA_EVERY_HOURS=24
